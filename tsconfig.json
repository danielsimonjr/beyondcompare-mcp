{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // TypeScript 7.0.2 does not auto-include node_modules/@types here. Repos that
    // typecheck without this are being rescued by a DEPENDENCY that ships its own
    // node reference (gmail-mcp gets one via googleapis -> node-fetch), which breaks
    // the moment that dependency changes. Declare the types this package needs.
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["tests/**", "dist/**", "node_modules/**"]
}
