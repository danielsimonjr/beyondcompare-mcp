{
  "name": "@danielsimonjr/beyondcompare-mcp",
  "version": "1.1.0",
  "description": "MCP server for Beyond Compare - file/folder comparison, merging, and sync for Windows",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "beyondcompare-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "mcp",
    "beyond-compare",
    "diff",
    "compare",
    "merge",
    "sync",
    "windows",
    "bcomp"
  ],
  "author": "Daniel Simon Jr. (https://github.com/danielsimonjr)",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielsimonjr/beyondcompare-mcp.git"
  },
  "homepage": "https://github.com/danielsimonjr/beyondcompare-mcp"
}
